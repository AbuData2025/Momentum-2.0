rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validWorkout(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.distanceKm is number && d.distanceKm > 0 && d.distanceKm < 120
        && d.durationSec is int && d.durationSec > 0
        && d.runType in ['easy', 'steady', 'tempo', 'long', 'intervals'];
    }
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /workouts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWorkout(request.resource.data);
      }
      match /plans/{planId} {
        allow read, write: if isOwner(uid);
        match /sessions/{id} { allow read, write: if isOwner(uid); }
      }
    }
  }
}
